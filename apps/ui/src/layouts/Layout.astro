---
interface Props {
  title?: string;
}

const { title = "filegate" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
